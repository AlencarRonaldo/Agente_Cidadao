generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConversaUsuario {
  id              String         @id @default(cuid())
  phoneNumber     String         @unique
  estado          EstadoConversa @default(INICIAL)
  dadosTemp       Json?
  ultimaInteracao DateTime       @default(now())
  expiresAt       DateTime
  tentativas      Int            @default(0)
  problemaTemp    String?
  enderecoTemp    String?
  bairroTemp      String?
  imagemTemp      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([expiresAt])
}

model Denuncia {
  id                  String         @id @default(cuid())
  protocolo           String         @unique
  texto               String
  textoFiltrado       String?
  endereco            String
  bairro              String
  imagemUrl           String
  status              Status         @default(RECEBIDA)
  vereadores          String[]
  conversaCompleta    Json?
  tempoConversa       Int?
  aprovadaBot         Boolean        @default(false)
  scoreBot            Float?
  motivoRejeicaoBot   String?
  aprovadaAdmin       Boolean        @default(false)
  motivoRejeicaoAdmin String?
  editadaPorAdmin     Boolean        @default(false)
  observacoesAdmin    String?
  createdAt           DateTime       @default(now())
  processedAt         DateTime?
  reviewedAt          DateTime?
  publishedAt         DateTime?
  phoneNumber         String
  adminUserId         String?
  instagramPostId     String?
  lastAttemptAt       DateTime?
  priority            Int?           @default(1)
  publishAttempts     Int            @default(0)
  publishError        String?
  scheduledPublishAt  DateTime?
  metadata            Json?
  photoPending        PhotoPending[]

  @@index([phoneNumber, createdAt])
  @@index([scheduledPublishAt])
  @@index([priority])
  @@index([instagramPostId])
}

model Vereador {
  id             String   @id @default(cuid())
  nome           String
  instagram      String   @unique
  partido        String
  ativo          Boolean  @default(true)
  bairros        String[]
  mencoes        Int      @default(0)
  especialidades String[]
  responsivo     Boolean  @default(true)
  prioridade     Int      @default(1)
  createdAt      DateTime @default(now())

  @@index([bairros])
}

model Bairro {
  id            String   @id @default(cuid())
  nome          String   @unique
  aliases       String[]
  cidade        String   @default("São Paulo")
  regiao        String
  subprefeitura String?
  ativo         Boolean  @default(true)
  denuncias     Int      @default(0)

  @@index([nome])
  @@index([aliases])
}

model AdminUser {
  id        String    @id @default(cuid())
  nome      String
  email     String    @unique
  senha     String
  role      Role      @default(MODERADOR)
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  lastLogin DateTime?
}

model PhotoPending {
  id              String    @id @default(cuid())
  denunciaId      String
  originalName    String
  filename        String
  mimeType        String
  fileSize        Int
  photoPath       String?
  thumbnailPath   String?
  metadata        String?
  isEncrypted     Boolean   @default(false)
  encryptionKey   String?
  status          String    @default("PENDING")
  uploadedAt      DateTime  @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  comments        String?
  publishedAt     DateTime?
  instagramPostId String?
  instagramUrl    String?
  cleanedUpAt     DateTime?
  processingTime  Int?
  denuncia        Denuncia  @relation(fields: [denunciaId], references: [id])

  @@index([cleanedUpAt])
  @@index([denunciaId])
  @@index([publishedAt])
  @@index([status])
  @@index([uploadedAt])
}

model PhotoAuditLog {
  id        String   @id @default(cuid())
  photoId   String
  action    String
  userId    String
  metadata  String?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([photoId])
  @@index([timestamp])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminEmail  String
  action      String
  targetType  String
  targetId    String
  details     Json?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  
  @@index([adminUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([timestamp])
}

model instagram_images {
  id             String   @id
  filename       String   @unique
  original_path  String
  processed_path String
  thumbnail_path String
  public_url     String
  thumbnail_url  String
  file_size      Int
  original_size  Int
  width          Int
  height         Int
  aspect_ratio   Decimal  @db.Decimal(10, 6)
  mime_type      String
  metadata       Json     @default("{}")
  created_at     DateTime @default(now())
  expires_at     DateTime

  @@index([created_at])
  @@index([expires_at])
  @@index([file_size])
}

model instagram_tokens {
  id              String    @id
  user_id         String    @unique
  username        String
  account_type    String
  token_type      String
  encrypted_token String
  encryption_iv   String
  encryption_tag  String
  expires_at      DateTime
  created_at      DateTime  @default(now())
  refreshed_from  String?
  is_active       Boolean   @default(true)
  revoked_at      DateTime?

  @@index([created_at])
  @@index([expires_at])
  @@index([is_active])
}

enum EstadoConversa {
  INICIAL
  AGUARDANDO_PROBLEMA
  AGUARDANDO_ENDERECO
  AGUARDANDO_ENDERECO_CORRIGIDO
  AGUARDANDO_FOTO
  AGUARDANDO_CONFIRMACAO
  DENUNCIA_PROCESSADA
  CONSULTANDO_STATUS
  EDITANDO_DENUNCIA
  SELECIONANDO_CATEGORIA
  SELECIONANDO_SUBCATEGORIA
}

enum Status {
  RECEBIDA
  VALIDANDO_CONVERSA
  BAIRRO_INVALIDO
  PROCESSANDO
  APROVADA_BOT
  PENDENTE_MODERACAO
  REJEITADA_BOT
  APROVADA_ADMIN
  REJEITADA_ADMIN
  AGENDADA
  PUBLICADA
  ERRO
  NAO_ENCONTRADA
  TEXTO_INVALIDO
}

enum Role {
  ADMIN
  MODERADOR
  VISUALIZADOR
}
