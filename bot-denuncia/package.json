{
  "name": "bot-denuncia",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para denúncias cidadãs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "workers": "node src/startWorkers.js",
    "workers:dev": "nodemon src/startWorkers.js",
    "all": "concurrently \"npm run start\" \"npm run workers\"",
    "all:dev": "concurrently \"npm run dev\" \"npm run workers:dev\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":80,\"functions\":80,\"lines\":80,\"statements\":80}}'",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:security": "jest tests/security",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "cd tests/performance/k6 && node run-load-tests.js",
    "test:load": "k6 run tests/performance/k6/admin-api-load-test.js",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "security:audit": "npm audit --audit-level=moderate",
    "security:scan": "npm run test:security",
    "build": "npm run build:admin",
    "build:admin": "cd admin-panel && npm run build",
    "docker:build": "docker build -t bot-denuncia .",
    "docker:run": "docker run -p 3000:3000 -p 3001:3001 bot-denuncia",
    "ci": "npm run lint && npm run test:all && npm run test:e2e && npm run test:performance",
    "ci:coverage": "npm run test:coverage && npm run test:e2e && npm run test:performance",
    "report:generate": "node scripts/generate-test-reports.js",
    "report:coverage": "open coverage/lcov-report/index.html",
    "report:e2e": "npm run test:e2e:report",
    "fix:chrome": "chrome-fix.bat",
    "instagram:validate": "node src/scripts/runInstagramValidation.js",
    "instagram:health": "node src/scripts/instagramHealthCheck.js",
    "instagram:test": "jest tests/integration/instagramValidation.test.js",
    "instagram:report": "node src/scripts/instagramHealthCheck.js --format json --output instagram-health-report.json"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "denuncias",
    "cidadas",
    "instagram",
    "automation",
    "nodejs"
  ],
  "author": "Bot Denúncia Team",
  "license": "MIT",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "no-console": "warn",
      "prefer-const": "error",
      "no-var": "error"
    },
    "ignorePatterns": [
      "node_modules/",
      "coverage/",
      "build/",
      "dist/"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "dependencies": {
    "@prisma/client": "^5.x",
    "axios": "^1.x",
    "bcryptjs": "^2.x",
    "bull": "^4.x",
    "bullmq": "^5.x",
    "concurrently": "^8.x",
    "cors": "^2.x",
    "dotenv": "^16.x",
    "express": "^4.x",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.x",
    "helmet": "^7.x",
    "instagram-private-api": "^1.46.1",
    "ioredis": "^5.x",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.x",
    "multer": "^2.0.2",
    "node-cron": "^3.x",
    "pino": "^8.x",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.x",
    "sharp": "^0.34.3",
    "whatsapp-web.js": "^1.x",
    "xstate": "^5.20.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@jpisnice/shadcn-ui-mcp-server": "^1.0.3",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "axe-playwright": "^2.1.0",
    "babel-jest": "^30.0.5",
    "eslint": "^8.57.0",
    "globals": "^16.3.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "nodemon": "^3.x",
    "prettier": "^3.0.0",
    "prisma": "^5.x",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/bot-denuncia.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/bot-denuncia/issues"
  },
  "homepage": "https://github.com/your-org/bot-denuncia#readme"
}
